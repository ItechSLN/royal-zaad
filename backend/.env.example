DATABASE_URL=
PORT=8080
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
 
# --- Production (the server refuses to start with NODE_ENV=production unless these are set) ---
NODE_ENV=
# Random string, 32+ characters: `openssl rand -hex 32`
# (JWT_SECRET above)
# Comma-separated storefront origins allowed to call the API, e.g. https://shop.example.com
CORS_ORIGINS=
# Public storefront URL, used for links in emails (order tracking, password reset)
APP_URL=

# --- Email (SMTP — any provider: SES, Mailgun, Postmark, Gmail…) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Royal Zaad <orders@royalzaad.com>"

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint pointed at <API>/api/v1/payments/stripe/webhook
# (events: payment_intent.succeeded, payment_intent.payment_failed)
STRIPE_WEBHOOK_SECRET=
# Unpaid card orders are cancelled and their stock released after this many minutes
ORDER_PAYMENT_TIMEOUT_MINUTES=60

# Number of reverse-proxy hops in front of the API (e.g. 1 behind a load balancer) so rate limits see real client IPs
TRUST_PROXY=
# Sign-in / reset attempts per IP per minute (default 10 in production)
AUTH_RATE_LIMIT=
# Contact-form messages per IP per 10 minutes (default 5 in production)
CONTACT_RATE_LIMIT=
