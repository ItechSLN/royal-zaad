generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// What a role is allowed to do — authorization keys off this, not the role name.
enum RoleKind {
  CUSTOMER
  VENDOR
  STAFF
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductModeration {
  APPROVED
  PENDING_REVIEW
  REJECTED
  REMOVED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum ReportTarget {
  PRODUCT
  SHOP
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum OrderChannel {
  WEB
  APP
  POS
  MARKETPLACE
}

enum CustomerTier {
  STANDARD
  GOLD
  PLATINUM
}

enum WarehouseStatus {
  OPERATIONAL
  MAINTENANCE
  CLOSED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  LATE
}

enum AdjustmentReason {
  COUNT
  DAMAGE
  RECEIPT
  TRANSFER
  RETURN
}

enum SupplierStatus {
  ACTIVE
  ON_HOLD
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  OVERDUE
  RECEIVED
  CANCELLED
}

enum ShipmentStatus {
  AWAITING_DISPATCH
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum ReturnStage {
  AWAITING_INSPECTION
  APPROVED
  REJECTED
  REFUNDED
}

enum RefundMethod {
  ORIGINAL
  STORE_CREDIT
  NONE
}

enum RestockDecision {
  SELLABLE
  QUARANTINE
  WRITE_OFF
}

enum InvoiceStatus {
  OPEN
  PAID
  OVERDUE
  VOID
}

enum FilingStatus {
  DRAFT
  FILED
}

enum CampaignChannel {
  EMAIL
  PUSH
  SMS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ContactTopic {
  ORDER
  PRODUCT
  RETURNS
  WHOLESALE
  PRESS
  OTHER
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum AlertSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  passwordHash        String
  firstName           String
  lastName            String
  isActive            Boolean                  @default(true)
  department          String?
  roleId              String
  role                Role                     @relation(fields: [roleId], references: [id])
  emailVerifiedAt     DateTime?
  customer            Customer?
  vendor              Vendor?
  passwordResetTokens PasswordResetToken[]
  verificationTokens  EmailVerificationToken[]
  reports             Report[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A seller account. One shop per vendor today (unique vendorId on Shop).
model Vendor {
  id             String         @id @default(cuid())
  /// Null only for the platform's own vendor (the original single shop).
  userId         String?        @unique
  isPlatform     Boolean        @default(false)
  status         VendorStatus   @default(PENDING)
  statusReason   String?
  /// Null = the platform default commission (Settings: marketplace_commission_rate).
  commissionRate Decimal?       @db.Decimal(5, 2)
  approvedAt     DateTime?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop           Shop?
  payouts        VendorPayout[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

/// A storefront operated by a vendor. Location columns feed distance search
/// (GiST index on shop_earth(latitude, longitude), created in SQL).
model Shop {
  id                 String        @id @default(cuid())
  vendorId           String        @unique
  name               String
  slug               String        @unique
  description        String?       @db.Text
  logoUrl            String?
  logoPublicId       String?
  email              String?
  phone              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?       @db.Char(2)
  latitude           Float?
  longitude          Float?
  /// Set once the address has been geocoded or confirmed by an admin;
  /// distance is never computed from an unverified location.
  locationVerifiedAt DateTime?
  openingHours       Json?
  offersDelivery     Boolean       @default(true)
  offersPickup       Boolean       @default(false)
  deliveryRadiusKm   Float?
  shippingFlatFee    Decimal?      @db.Decimal(10, 2)
  freeShippingOver   Decimal?      @db.Decimal(10, 2)
  isActive           Boolean       @default(true)
  vendor             Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products           Product[]
  vendorOrders       VendorOrder[]
  orderItems         OrderItem[]
  reports            Report[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([isActive])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  kind        RoleKind @default(STAFF)
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique
  /// Unique within a shop, not across the marketplace.
  sku  String

  shopId           String
  shop             Shop              @relation(fields: [shopId], references: [id])
  moderationStatus ProductModeration @default(APPROVED)
  /// Why an admin rejected or removed it — shown to the vendor.
  moderationReason String?           @db.Text
  archivedAt       DateTime?

  shortDescription String? @db.VarChar(255)
  description      String? @db.Text

  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  costPrice      Decimal? @db.Decimal(10, 2)
  /// GTIN — also groups the same product sold by several shops.
  barcode        String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  images ProductImage[]

  categoryId String
  brandId    String?

  category Category @relation(fields: [categoryId], references: [id])
  brand    Brand?   @relation(fields: [brandId], references: [id])

  inventory     Inventory?
  orderItems    OrderItem[]
  reviews       Review[]
  promotions    Promotion[]
  purchaseItems PurchaseOrderItem[]

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  variants   ProductVariant[]
  wishlisted WishlistItem[]
  reports    Report[]

  /// Weighted full-text document (name A, short description B, description C),
  /// kept current by the product_search_vector trigger. Never written by the app.
  searchVector Unsupported("tsvector")?

  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  /// Typo-tolerant name search (pg_trgm). The shop GiST distance index is an
  /// expression index managed in SQL migrations.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([searchVector], type: Gin, map: "Product_searchVector_idx")
  @@index([shopId])
  @@index([barcode])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

/**
 * A customer's saved products. One row per customer/product pair.
 */
model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  sku            String   @unique
  barcode        String?
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  costPrice      Decimal? @db.Decimal(10, 2)
  quantity       Int      @default(0)
  warehouseId    String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([warehouseId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  publicId  String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text

  imageUrl      String?
  imagePublicId String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  sortOrder  Int     @default(0)
  isVisible  Boolean @default(true)
  showInNav  Boolean @default(true)
  isFeatured Boolean @default(false)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Category_name_trgm_idx")
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Inventory {
  id          String                @id @default(cuid())
  productId   String                @unique
  warehouseId String?
  quantity    Int                   @default(0)
  reserved    Int                   @default(0)
  reorderAt   Int                   @default(0)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse?            @relation(fields: [warehouseId], references: [id])
  adjustments InventoryAdjustment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([warehouseId])
}

model InventoryAdjustment {
  id          String           @id @default(cuid())
  inventoryId String
  reason      AdjustmentReason
  quantity    Int
  reserved    Int              @default(0)
  reorderAt   Int              @default(0)
  delta       Int              @default(0)
  note        String?          @db.Text
  createdById String?
  inventory   Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([inventoryId])
}

model Warehouse {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  city           String
  address        String?          @db.Text
  manager        String?
  capacity       Int              @default(0)
  status         WarehouseStatus  @default(OPERATIONAL)
  isDefault      Boolean          @default(false)
  inventories    Inventory[]
  transfersOut   StockTransfer[]  @relation("TransferFrom")
  transfersIn    StockTransfer[]  @relation("TransferTo")
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  variants       ProductVariant[]
}

model StockTransfer {
  id         String         @id @default(cuid())
  reference  String         @unique
  fromId     String
  toId       String
  units      Int            @default(0)
  status     TransferStatus @default(DRAFT)
  expectedAt DateTime?
  receivedAt DateTime?
  note       String?        @db.Text
  from       Warehouse      @relation("TransferFrom", fields: [fromId], references: [id])
  to         Warehouse      @relation("TransferTo", fields: [toId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([fromId])
  @@index([toId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  category       String?
  country        String?
  leadTimeDays   Int             @default(0)
  contactName    String?
  email          String?
  phone          String?
  paymentTerms   String?
  rating         Decimal?        @db.Decimal(3, 2)
  onTimeRate     Decimal?        @db.Decimal(5, 2)
  ytdSpend       Decimal         @default(0) @db.Decimal(12, 2)
  status         SupplierStatus  @default(ACTIVE)
  notes          String?         @db.Text
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  supplierId  String
  warehouseId String?
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  receivedAt  DateTime?
  units       Int                 @default(0)
  total       Decimal             @default(0) @db.Decimal(12, 2)
  reference   String?
  notes       String?             @db.Text
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse?          @relation(fields: [warehouseId], references: [id])
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model Shipment {
  id            String         @id @default(cuid())
  awb           String         @unique
  orderId       String
  vendorOrderId String?
  vendorOrder   VendorOrder?   @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)
  carrier       String
  service       String?
  city          String?
  status        ShipmentStatus @default(AWAITING_DISPATCH)
  eta           DateTime?
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  attempts      Int            @default(0)
  instructions  String?        @db.Text
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orderId])
  @@index([vendorOrderId])
}

model ReturnRequest {
  id           String           @id @default(cuid())
  rmaNumber    String           @unique
  orderId      String
  customerId   String
  orderItemId  String?
  reason       String
  stage        ReturnStage      @default(AWAITING_INSPECTION)
  refundAmount Decimal          @default(0) @db.Decimal(10, 2)
  refundMethod RefundMethod?
  restock      RestockDecision?
  note         String?          @db.Text
  resolvedAt   DateTime?
  order        Order            @relation(fields: [orderId], references: [id])
  customer     Customer         @relation(fields: [customerId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([orderId])
  @@index([customerId])
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  customerId String
  orderId    String?       @unique
  issuedAt   DateTime      @default(now())
  dueAt      DateTime
  amount     Decimal       @db.Decimal(12, 2)
  balance    Decimal       @db.Decimal(12, 2)
  terms      String?
  status     InvoiceStatus @default(OPEN)
  notes      String?       @db.Text
  customer   Customer      @relation(fields: [customerId], references: [id])
  order      Order?        @relation(fields: [orderId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([customerId])
}

model TaxRate {
  id           String   @id @default(cuid())
  jurisdiction String
  /// ISO 3166-1 alpha-2 code matched against the order's shipping address.
  countryCode  String?
  registration String?
  rate         Decimal  @db.Decimal(5, 2)
  appliesTo    String   @default("all")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TaxFiling {
  id           String       @id @default(cuid())
  period       String
  jurisdiction String
  outputTax    Decimal      @default(0) @db.Decimal(12, 2)
  inputTax     Decimal      @default(0) @db.Decimal(12, 2)
  netPayable   Decimal      @default(0) @db.Decimal(12, 2)
  dueAt        DateTime
  filedAt      DateTime?
  status       FilingStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([period, jurisdiction])
}

model Campaign {
  id        String          @id @default(cuid())
  name      String
  channel   CampaignChannel @default(EMAIL)
  audience  String?
  subject   String?
  preview   String?         @db.Text
  sendAt    DateTime?
  alwaysOn  Boolean         @default(false)
  sent      Int             @default(0)
  openRate  Decimal?        @db.Decimal(5, 2)
  revenue   Decimal         @default(0) @db.Decimal(12, 2)
  status    CampaignStatus  @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CmsPost {
  id        String     @id @default(cuid())
  title     String
  slug      String     @unique
  author    String?
  category  String?
  excerpt   String?    @db.Text
  body      String?    @db.Text
  shoppable Boolean    @default(false)
  views     Int        @default(0)
  status    PostStatus @default(DRAFT)
  publishAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model AlertRule {
  id        String        @id @default(cuid())
  name      String
  category  String?
  severity  AlertSeverity @default(INFO)
  channels  String?
  threshold String?
  isMuted   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Notification {
  id        String        @id @default(cuid())
  title     String
  body      String?       @db.Text
  severity  AlertSeverity @default(INFO)
  meta      String?
  unread    Boolean       @default(true)
  ruleId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([unread])
}

/**
 * Enquiries raised from the storefront contact form.
 */
model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  topic        ContactTopic  @default(OTHER)
  orderNumber  String?
  subject      String?
  message      String        @db.Text
  status       ContactStatus @default(NEW)
  handledById  String?
  internalNote String?       @db.Text
  respondedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  meta      String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  customerId        String
  couponId          String?
  shippingAddressId String?
  status            OrderStatus     @default(PENDING)
  subtotal          Decimal         @db.Decimal(10, 2)
  discountTotal     Decimal         @default(0) @db.Decimal(10, 2)
  taxTotal          Decimal         @default(0) @db.Decimal(10, 2)
  shippingTotal     Decimal         @default(0) @db.Decimal(10, 2)
  total             Decimal         @db.Decimal(10, 2)
  customer          Customer        @relation(fields: [customerId], references: [id])
  coupon            Coupon?         @relation(fields: [couponId], references: [id])
  shippingAddress   Address?        @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  channel           OrderChannel    @default(WEB)
  /// Client-generated per checkout attempt; a retry returns the same order.
  idempotencyKey    String?
  vendorOrders      VendorOrder[]
  items             OrderItem[]
  payment           Payment?
  shipments         Shipment[]
  returns           ReturnRequest[]
  invoice           Invoice?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([customerId])
  @@index([couponId])
  @@index([shippingAddressId])
}

/// One shop's share of a checkout: fulfilled, shipped and paid out independently.
model VendorOrder {
  id                String            @id @default(cuid())
  orderId           String
  shopId            String
  status            OrderStatus       @default(PENDING)
  fulfillmentMethod FulfillmentMethod @default(DELIVERY)
  subtotal          Decimal           @db.Decimal(10, 2)
  discountTotal     Decimal           @default(0) @db.Decimal(10, 2)
  shippingTotal     Decimal           @default(0) @db.Decimal(10, 2)
  taxTotal          Decimal           @default(0) @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  commissionRate    Decimal           @default(0) @db.Decimal(5, 2)
  commissionAmount  Decimal           @default(0) @db.Decimal(10, 2)
  vendorNet         Decimal           @default(0) @db.Decimal(10, 2)
  payoutId          String?
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop              Shop              @relation(fields: [shopId], references: [id])
  payout            VendorPayout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  shipments         Shipment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([orderId, shopId])
  @@index([shopId, status])
  @@index([payoutId])
}

model VendorPayout {
  id           String        @id @default(cuid())
  vendorId     String
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("USD") @db.Char(3)
  status       PayoutStatus  @default(PENDING)
  reference    String?
  note         String?       @db.Text
  periodStart  DateTime?
  periodEnd    DateTime?
  paidAt       DateTime?
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorOrders VendorOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([vendorId, status])
}

/// A customer's report against a product or shop, for admin review.
model Report {
  id         String       @id @default(cuid())
  reporterId String?
  targetType ReportTarget
  productId  String?
  shopId     String?
  reason     String
  details    String?      @db.Text
  status     ReportStatus @default(OPEN)
  resolution String?      @db.Text
  resolvedAt DateTime?
  reporter   User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  product    Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop       Shop?        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([productId])
  @@index([shopId])
}

model OrderItem {
  id            String      @id @default(cuid())
  orderId       String
  vendorOrderId String
  shopId        String
  productId     String
  /// Snapshot at purchase time — later product edits never rewrite history.
  productName   String
  sku           String
  imageUrl      String?
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  shop          Shop        @relation(fields: [shopId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([shopId])
  @@index([productId])
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?      @db.Text
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)
  minimumPurchase Decimal?     @db.Decimal(10, 2)
  usageLimit      Int?
  usageCount      Int          @default(0)
  startsAt        DateTime
  expiresAt       DateTime?
  isActive        Boolean      @default(true)
  orders          Order[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Promotion {
  id            String       @id @default(cuid())
  name          String
  description   String?      @db.Text
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean      @default(true)
  products      Product[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  provider       String
  transactionId  String?       @unique
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD") @db.Char(3)
  status         PaymentStatus @default(PENDING)
  /// Refunded so far — a shop cancelling its part of a paid order refunds just that part.
  refundedAmount Decimal       @default(0) @db.Decimal(10, 2)
  paidAt         DateTime?
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Customer {
  id        String          @id @default(cuid())
  userId    String?         @unique
  email     String          @unique
  firstName String
  lastName  String
  phone     String?
  tier      CustomerTier    @default(STANDARD)
  notes     String?         @db.Text
  user      User?           @relation(fields: [userId], references: [id])
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  returns   ReturnRequest[]
  invoices  Invoice[]
  wishlist  WishlistItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Address {
  id             String    @id @default(cuid())
  customerId     String
  label          String?
  recipientName  String
  line1          String
  line2          String?
  city           String
  state          String?
  postalCode     String
  country        String    @db.Char(2)
  phone          String?
  isDefault      Boolean   @default(false)
  latitude       Float?
  longitude      Float?
  geocodedAt     DateTime?
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingOrders Order[]   @relation("ShippingAddress")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  title      String?
  content    String?  @db.Text
  isApproved Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([customerId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
